{
  "name": "webtag-extension",
  "displayName": "WebTag Capture",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "description": "WebTag browser extension — capture the current page to WebTag from the popup or context menu.",
  "scripts": {
    "dev": "pnpm run clear && cross-env NODE_ENV=development run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "pnpm run build:background -- --mode development",
    "dev:web": "vite",
    "dev:js": "pnpm run build:js -- --mode development",
    "build:prepare": "esno scripts/prepare.ts",
    "build:web": "vite build",
    "build:js": "vite build --config vite.config.content.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "build": "run-p build:chrome build:firefox",
    "build:debug": "cross-env NODE_ENV=production BROWSER=chrome NO_MINIFY=true run-s clear:chrome build:web build:js build:prepare build:background",
    "build:chrome": "cross-env NODE_ENV=production BROWSER=chrome run-s clear:chrome build:web build:js build:prepare build:background",
    "build:firefox": "cross-env NODE_ENV=production BROWSER=firefox run-s clear:firefox build:web build:js build:prepare build:background",
    "verify:build": "run-p verify:build:chrome verify:build:firefox",
    "verify:build:chrome": "esno scripts/verify-build-output.ts extension-chrome",
    "verify:build:firefox": "esno scripts/verify-build-output.ts extension-firefox",
    "pack": "run-p pack:chrome pack:firefox pack:source",
    "pack:chrome": "esno scripts/package-install.ts chrome",
    "pack:firefox": "esno scripts/package-install.ts firefox",
    "pack:source": "esno scripts/package-source.ts",
    "verify:artifacts": "run-s verify:install verify:source",
    "verify:install": "esno scripts/verify-install-archives.ts",
    "verify:source": "esno scripts/verify-source-archive.ts",
    "clear": "run-p clear:chrome clear:firefox clear:source",
    "clear:chrome": "esno scripts/clean.ts extension-chrome dist/webtag-chrome.zip",
    "clear:firefox": "esno scripts/clean.ts extension-firefox dist/webtag-firefox.zip",
    "clear:source": "esno scripts/clean.ts dist/webtag-source.zip",
    "release": "run-s api:check build verify:build pack verify:artifacts",
    "api:generate": "pnpm --filter @webtag/api api:generate",
    "api:check": "pnpm --filter @webtag/api api:check",
    "lint": "eslint './src/**/*.{vue,ts}' --max-warnings 0",
    "lint:fix": "eslint './src/**/*.{vue,ts}' --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest test",
    "test:coverage": "vitest test --coverage"
  },
  "dependencies": {
    "@webtag/api": "workspace:*",
    "naive-ui": "^2.45.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^5.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.13.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/test-utils": "^2.4.11",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "esno": "^4.8.0",
    "globals": "17.11.0",
    "jszip": "3.10.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "3.3.10",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint --fix"
    ]
  }
}
