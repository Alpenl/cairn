DATABASE_URL=postgres://postgres:password@localhost:5432/webtag
# 填你自己的 OpenAI 兼容端点。示例值是占位符，不是可用地址。
#
# 若该端点走明文 HTTP：只能从与它同机 / 同一可信内网的 WebTag 访问。
# AI_API_KEY 是 Bearer 凭证，跨不可信网络必须走 TLS 或可信隧道。
#
# 也不要把真实地址写回本文件——它进版本控制，而一个可达的推理网关地址
# 加上「它跑在 8000 端口、明文 HTTP」这两条信息，本身就是攻击面。
# 真实值放部署环境的 secret 里。
AI_BASE_URL=http://your-grok-gateway.internal:8000/v1
AI_API_KEY=
AI_MODEL=grok-4.3-fast

# 运行环境标记。仅 "dev" 一个值有特殊语义 —— 允许 admin 路由在未配置
# ADMIN_AUTH_TOKEN 时对外开放（便于本地调试 admin/concept-merges UI）。
# staging / prod / 任何其他值都会触发 fail-closed：admin 路由必须带
# Bearer token，否则一律 401。默认 prod。
APP_ENV=prod

# Optional runtime tuning
# PARSE_CONCURRENCY：解析并发度。Phase 13（v4.0 M2）起映射为 River 默认队列的
# MaxWorkers（每个 API 副本各自跑这么多 worker；River 从 river_job 表事务性
# 拉取，多副本安全）。
PARSE_CONCURRENCY=3
LISTEN_ADDR=:8000
# 允许跨域访问的来源列表，逗号分隔，精确匹配（`*` 表示放行所有来源）。
# WebTag 浏览器扩展从 `chrome-extension://<extension-id>` 源调用公开 API，
# 接入扩展时必须把该来源加进来，例如：
#   CORS_ORIGINS=http://localhost:3000,chrome-extension://abcdefghijklmnopabcdefghijklmnop
# 也可用 `*` 放行所有来源（自托管单用户场景可接受）。
CORS_ORIGINS=http://localhost:3000
# Comma-separated ingress/proxy CIDRs trusted to set X-Forwarded-For and
# X-Real-IP. Empty (default) ignores forwarding headers and uses RemoteAddr.
# Never use 0.0.0.0/0 or ::/0; startup rejects trust-all ranges.
TRUSTED_PROXY_CIDRS=

# 应用日志级别（debug / info / warn / error），默认 info。线上推荐
# info；排查问题时可临时调到 debug 看更多结构化字段。
LOG_LEVEL=info

# 日志输出格式（json / text），默认 json。生产保持 json，便于
# Loki / ELK / Splunk 等聚合系统按字段索引。本地开发推荐 text：
# 输出人类可读的 key=value 文本，并启用 AddSource 显示日志触发点
# 的 file:line，stack 一目了然。
LOG_FORMAT=json

# Optional HTTP server timeouts, in milliseconds
READ_HEADER_TIMEOUT_MS=2000
READ_TIMEOUT_MS=10000
WRITE_TIMEOUT_MS=15000
IDLE_TIMEOUT_MS=60000

# 优雅停机总预算（毫秒），默认 30000 = 30s。Server.Shutdown 把它拆成
# 两阶段：阶段 1（70% ≈ 21s）httpServer.Shutdown 拒收新连接 + 等
# in-flight 请求自然结束；阶段 2（30% ≈ 9s）Lifecycle.Close 排空 worker
# queue、关闭连接池、flush tracer。
#
# 部署 k8s 时务必让 SHUTDOWN_TIMEOUT_MS 略低于 pod 的
# terminationGracePeriodSeconds（默认 30s），给容器自身的退出留 5~10%
# 余量；否则 kubelet 在 grace 到期后会发 SIGKILL，跳过阶段 2，worker
# 在写库中途被截断。下界 1000，低于此值的预算无法完成 worker 排空。
SHUTDOWN_TIMEOUT_MS=30000

# Optional fetch retry controls
FETCH_RETRY_ATTEMPTS=2
FETCH_RETRY_DELAY_MS=25
# When true the parse pipeline defaults to the truncated "tag-only" fetch
# path (Range-limited HTTP + first ~1000 chars of body), saving ~7x LLM
# input tokens per link. Per-link SourceMetadata["parse_depth"]="deep"
# overrides at submit time when a specific link needs full-body analysis.
FETCH_PREFER_LIGHT=false
# 解析模式：
#   grok_direct（默认）— 让已配置的 Grok 分析端点自抓 URL；模型无法访问时
#                        回退本地专用/基础抓取链。
#   fetcher            — 强制用本地抓取器获取正文，必要时回退 Jina，再交给模型分析。
#                        抓不到原文时明确失败，不会用搜索结果摘要冒充原文。
# 仅接受 fetcher / grok_direct；其它值会导致服务启动失败。
PARSE_MODE=grok_direct

# Optional analyzer retry and timeout controls
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_MS=25
AI_REQUEST_TIMEOUT_MS=60000

# Allow private or loopback analyzer gateways only when explicitly required
AI_ALLOW_UNSAFE_TARGETS=false

# 关闭分析请求上的 strict json_schema（response_format）。默认 false（开启）：
# 结构化输出让上游按 schema 约束解码，直接消灭"模型不按 JSON 契约回复"这类失败。
#
# 作用范围：**普通解析路径全部走它**——schema 按输出契约选，日常解析恒为网站收藏
# v2 的判别式联合体。不发该字段的只有两条：grok URL 直连（其 accessible 字段是
# 本地抓取器回退的依据）与 eval 的 prompt override（实验自持输出形状）。
#
# 一般不需要动这个开关：网关不支持时会返回 400/422，analyzer 自动摘掉该字段、
# 原样重发、本进程内不再发送，并 WARN 一次。首次结构化请求成功之前，任何 400/422
# 都触发降级（那时唯一变化的就是这个字段）；成功过之后只有错误明确点名
# response_format / json_schema 才降级，避免一次超长正文的 context_length_exceeded
# 永久关掉该能力。
#
# 置 true 的场景：网关「接受了 response_format 却返回不可用正文」——自动降级探测
# 不到这种情况。日志里出现上面那条 WARN 且解析仍不稳定时，也可以直接用它止血。
AI_DISABLE_STRUCTURED_OUTPUT=false

# Optional yt-dlp video fetcher. Empty path = off. The published image does
# not include yt-dlp; set this only if you install the binary yourself.
YTDLP_BINARY_PATH=
YTDLP_TIMEOUT_MS=30000

# Optional GitHub fetcher token (raises rate limit on github.com URLs)
GITHUB_TOKEN=

# Tag aggregation cache TTL in milliseconds. Lower values surface new tags
# faster at the cost of more `tags` table scans.
TAG_CACHE_TTL_MS=300000

# Domain-summary aggregation cache TTL in milliseconds (GET /api/tree?view=domains).
# That endpoint used to run a full `GROUP BY domain` on every call while the
# Reader requests it on every main-view mount and every manual sync.
# Both aggregation caches are invalidated together. The
# invalidation points are (a) every successful mutating request on the public
# API, applied at the auth group's exit so new write endpoints are covered
# automatically, and (b) parse completion in the worker, on both the reading
# and the site branch. Lowering this therefore only trades DB load for
# freshness at the TTL boundary — not for correctness after a write.
TREE_CACHE_TTL_MS=300000

# Response compression. GZIP_ENABLED=false unmounts the middleware entirely
# (byte-for-byte identical to the pre-compression behaviour).
#
# Keep it on even behind a compressing reverse proxy: the proxy only covers
# deployments that have one. A self-hosted binary serving traffic directly
# gets no compression at all otherwise, and the list endpoints carry long
# text fields (summary / description / classification_explanation) that the
# Reader re-fetches every 30 seconds.
#
# GZIP_MIN_LENGTH is the response-body byte floor for compressing. Below it
# the ~20-byte gzip header/trailer plus the high entropy of short JSON tend
# to make the compressed form *larger*, so small responses are passed
# through untouched. /metrics, /health, /ready and /debug/pprof are always
# excluded regardless of size.
GZIP_ENABLED=true
GZIP_MIN_LENGTH=1024

# Embedding client — powers parse-time link vectors and semantic link search.
# EMBEDDING_MODEL empty (default) skips new link vectors and makes q= search
# fall back to ILIKE. Normal startup never scans or re-embeds historical rows.
# BASE_URL / API_KEY default to inheriting AI_BASE_URL / AI_API_KEY so a
# same-provider deployment only needs to set EMBEDDING_MODEL. The embedding
# transport honours the same SSRF allow-list as the analyzer (gated by
# AI_ALLOW_UNSAFE_TARGETS). DIMENSIONS is the vector width the model emits
# ([64, 8192], default 1536). The schema currently uses vector(1536); changing it
# away from 1536 requires a manual column migration (see internal/migrate/steps.go).
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# pgx connection pool sizing. DB_MIN_CONNS keeps idle connections warm for
# steady-state latency; DB_MAX_CONNS caps total database concurrency.
DB_MAX_CONNS=30
DB_MIN_CONNS=5

# pgxpool 连接生命周期。所有三项 <=0 时保留 pgx 默认（1h / 30min / 1min）。
# 生产部署在 PgBouncer / RDS Proxy 后面时强烈建议把 lifetime / idle 调得
# 比中间件的 server_idle_timeout 短，否则偶发会拿到一根已被对端 reset
# 的连接，表现为 "connection reset by peer" 长尾错误。
#
#   DB_MAX_CONN_LIFETIME_MS    单根连接最长存活时间（默认 30min）
#   DB_MAX_CONN_IDLE_TIME_MS   单根连接最长空闲时间（默认 10min）
#   DB_HEALTH_CHECK_PERIOD_MS  pgx 主动 ping 空闲连接的间隔（默认 1min）
DB_MAX_CONN_LIFETIME_MS=1800000
DB_MAX_CONN_IDLE_TIME_MS=600000
DB_HEALTH_CHECK_PERIOD_MS=60000

# /api/admin/* 路由的 Bearer token（concept-merges 审核接口必须经过）。
# 非 dev 环境（APP_ENV != dev）下必填：留空时 admin 路由仍会挂载，但
# 任何请求都会被 BearerAuthGin 拦截为 401（fail-closed），同时启动日志
# 会打 Warn。dev 环境留空则路由对外开放，方便本地调试。
ADMIN_AUTH_TOKEN=

# /metrics 与 /debug/pprof/* 共用的 Bearer token。留空时 /metrics 保持开放
# （兼容单机部署），但 pprof 永远拒绝在无 token 时挂载（详见 PPROF_ENABLED）。
#
# 留空还会降低指标精度：webtag_fetcher_duration_seconds 的 host_class 标签正常
# 记录抓取目标的 eTLD+1，也就是这台安装读过哪些站点。端点无鉴权时该标签固定为
# "unreported"，避免把阅读域名史暴露给任何能访问该端口的人。配置本 token 即可
# 同时拿回鉴权与完整的按域名诊断维度。
METRICS_AUTH_TOKEN=

# 公开 API（/api/ingest、/api/links*、/api/jobs*、/api/tags、/api/tree 及
# /api/v1/* 别名）的静态 Bearer token，供 Reader、浏览器扩展和移动端使用。
# 留空时公开 API fail-closed；服务不会生成或存储其它产品凭证。确需无鉴权
# 开放时显式设 PUBLIC_API_OPEN=true。
EXTENSION_API_TOKEN=

# 显式允许零凭证访问，默认 false。设为 true 之前先确认：这台服务只在可信
# 内网，或者前面有反向代理已经做过鉴权。
PUBLIC_API_OPEN=false

# Reader 浏览器会话 cookie 的 HMAC-SHA256 签名密钥。
#
# 作用：Reader 用 EXTENSION_API_TOKEN 换一张有期限的 httpOnly cookie（POST /api/session），
# 之后凭 cookie 请求。页面脚本读不到 cookie，也就外带不走——Reader 会渲染来自
# 第三方网页的标题 / 摘要 / 正文，这条防线针对的正是那个面。
#
# 留空不等于关闭：进程启动时会随机生成一把，密钥随进程消亡。代价是每次重启
# ——包括每次自动更新——所有会话当场失效，而 Reader 在 session 模式下浏览器里
# 不留安装令牌，届时前端手里没有任何可重放的凭证，用户只能重新填一次 key。
# 留空时启动会打一条 WARN 说明这件事；scripts/cairn-install.sh 在新建
# /opt/webtag/.env 时会直接生成一把，所以这一项通常只在手写配置时需要关心。
# 显式配置的两个理由：
#   1. 让会话跨重启存活；
#   2. 需要跨进程复用签名密钥时必须配置。
# 生成：openssl rand -base64 32
#
# 换密钥 = 强制全体重新登录，这是撤回无状态会话的唯一手段。
SESSION_SIGNING_KEY=

# 全新单安装数据库只注册当前 translation River job 类型。该值也是默认值；
# 保留在示例中是为了明确公开版不启用旧 worker 兼容模式。
TRANSLATION_JOBS_ROLLOUT=strict-v2

# 全新单安装数据库要求翻译请求携带当前 saved-content identity，缺失时
# fail closed。公开示例不提供旧客户端兼容窗口或存量升级路径。
TRANSLATION_SOURCE_ROLLOUT=strict

# RF6B terminal reconciler periodically repairs translation rows whose exact
# current River attempt reached a terminal state without projecting it back to
# link_translations. It also recovers current job references whose River row
# has been missing long enough to rule out ordinary queue/transaction latency.
#   - INTERVAL_MS: delay between complete scans; minimum 1000ms.
#   - BATCH: terminal jobs read per page; range [1, 1000].
#   - ROUND_TIMEOUT_MS: deadline for one complete scan; minimum 1ms.
#   - MISSING_AFTER_MS: age threshold before a missing current River job is
#     failed for retry. Must be greater than ROUND_TIMEOUT_MS.
TRANSLATION_RECONCILE_INTERVAL_MS=60000
TRANSLATION_RECONCILE_BATCH=100
TRANSLATION_RECONCILE_ROUND_TIMEOUT_MS=30000
TRANSLATION_RECONCILE_MISSING_AFTER_MS=21600000

# RF6C parse terminal/missing-job recovery and River terminal retention.
# The finite retention must be strictly greater than:
#   max(parse missing-after, translation missing-after)
#   + maximum declared recovery downtime
#   + max(parse interval+round timeout, translation interval+round timeout).
# Use RIVER_TERMINAL_RETENTION_MS=-1 only as a rollout/rollback escape hatch;
# it disables cleanup and therefore requires river_job capacity monitoring.
PARSE_RECONCILE_INTERVAL_MS=60000
PARSE_RECONCILE_BATCH=100
PARSE_RECONCILE_ROUND_TIMEOUT_MS=30000
PARSE_RECONCILE_MISSING_AFTER_MS=21600000
RIVER_TERMINAL_RETENTION_MS=604800000
RIVER_MAX_RECOVERY_DOWNTIME_MS=86400000

# /debug/pprof/* 总开关，默认关闭。pprof heap/goroutine dump 包含进程
# 内存里的字面量（含 token / 上游服务凭证残片），开启即数据泄露面。临时
# 排查性能问题时可设 true，但必须同时设置 METRICS_AUTH_TOKEN；任一
# 条件不满足，pprof 路由完全不挂载（请求返回 404 而不是 401）。
PPROF_ENABLED=false

# Link 列表游标的 HMAC-SHA256 签名密钥。留空时 Link 列表继续使用历史明文
# 游标格式；非空时也作为 READER_CURSOR_SIGNING_KEY 的兼容回退。
CURSOR_SIGNING_KEY=

# Reader activity 与 Thought 搜索游标的 HMAC-SHA256 签名密钥。
# APP_ENV != dev 时必须配置本项或 CURSOR_SIGNING_KEY，且有效值至少 32 字节。
# 专用值允许 Link 保持明文兼容，同时让 Reader/Thought 游标跨副本、跨重启稳定。
# APP_ENV=dev 且两项均为空时，才会从本地 DATABASE_URL 与 AI_API_KEY 派生。
# 推荐生成：openssl rand -hex 32
# 切换密钥会让已下发的 Reader/Thought 签名游标失效，客户端收到 422
# invalid_cursor；部署前需确认上游不会长期缓存旧 token。
READER_CURSOR_SIGNING_KEY=

# 每 IP 令牌桶限流。RPS=0（默认）关闭限流；RPS>0 时若 BURST=0 会按
# RPS 自动派生 1 秒容量。/metrics、/health、/ready 始终绕过限流，
# 避免抓取/探针把业务请求挤掉。
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=0

# Idempotency-Key 中间件（第二轮工程审计 API HIGH A1）。仅挂在公开 API
# 鉴权之后，并只对 POST/PUT/PATCH/DELETE 请求生效；客户端在请求头携带
# Idempotency-Key 时，中间件会按 (method, path, key) 缓存上一次
# 响应（仅 2xx / 4xx）。命中时直接回放 status + body + Content-Type，不再
# 调用 handler——既挡住"网络抖动 → 重试 → 重复 enqueue"，也不会绕过鉴权
# 无 Idempotency-Key 头的请求透传，不影响现有客户端。
#
# Phase 13（v4.0 M2）幂等下沉 PG：缓存改存 idempotency_keys 表
# （INSERT ON CONFLICT 抢占 + 回放），多副本部署下同一 Idempotency-Key 跨
# 副本生效（旧的进程内 LRU 在多副本下退化为 per-replica）。中间件仍不替代
# 后端 dedupe（DB source_key 唯一约束才是真正的资源防线），但现在挡客户端
# 重试 race 时跨副本一致。过期键由后台周期任务按 expires_at 清理。
#
#   IDEMPOTENCY_ENABLED   true 默认；false 完全不挂载中间件
#   IDEMPOTENCY_TTL_MS    缓存项过期时间，毫秒；0 → 中间件默认 24h
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_MS=0

# Historical website migration requires an operator-reviewed dry-run first.
SITE_MIGRATION_ENABLED=false
SITE_MIGRATION_DRY_RUN=true
SITE_MIGRATION_BATCH=100
SITE_MIGRATION_INTERVAL_MS=900000

# Website collection rollout controls. Each flag is independent: disabling
# writes or auto classification never hides existing sites or disables cleanup.
LIBRARY_KIND_API_ENABLED=true
SITE_LIBRARY_WRITE_ENABLED=true
SITE_AUTO_CLASSIFICATION_ENABLED=true
SITE_ADVANCED_MANAGEMENT_ENABLED=true

# OpenTelemetry OTLP 上报端点（gRPC，host:port 形式，如 otel-collector:4317）。
# 留空（默认）安装 noop tracer，不产生网络出口；填上后第二轮工程审计 H4
# 阶段的全链路接入会生效：Gin / outbound HTTP / pgx 都会记录 span 并通过
# BatchSpanProcessor 异步 flush 到该 collector。
#
#   OTEL_EXPORTER_OTLP_ENDPOINT     OTLP gRPC 端点；空 → noop tracer
#   OTEL_SAMPLING_RATIO             ParentBased(TraceIDRatioBased) 根采样率
#                                    默认 0.05 (5%)。范围 [0, 1]。
#                                    本地调试可调到 1.0 全采样，prod 推荐 0.01~0.10。
#   OTEL_EXPORTER_OTLP_INSECURE     OTLP gRPC 是否走明文（关 TLS）
#                                    默认 true（容器内 collector 调试方便）；
#                                    跨网络上报必须显式设 false 走 TLS。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLING_RATIO=0.05
OTEL_EXPORTER_OTLP_INSECURE=true
