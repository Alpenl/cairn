DATABASE_URL=postgres://postgres:password@localhost:5432/webtag
# 填你自己的 OpenAI 兼容端点。示例值是占位符，不是可用地址。
#
# 若该端点走明文 HTTP：只能从与它同机 / 同一可信内网的 WebTag 访问。
# AI_API_KEY 是 Bearer 凭证，跨不可信网络必须走 TLS 或可信隧道。
#
# 也不要把真实地址写回本文件——它进版本控制，而一个可达的推理网关地址
# 加上「它跑在 8000 端口、明文 HTTP」这两条信息，本身就是攻击面。
# 真实值放部署环境的 secret 里。
AI_BASE_URL=http://your-grok-gateway.internal:8000/v1
AI_API_KEY=
AI_MODEL=grok-4.3-fast

# 运行环境标记。默认 prod；dev 允许本地派生分页游标签名密钥。
APP_ENV=prod

# Optional runtime tuning
# PARSE_CONCURRENCY：解析并发度。Phase 13（v4.0 M2）起映射为 River 默认队列的
# MaxWorkers（每个 API 副本各自跑这么多 worker；River 从 river_job 表事务性
# 拉取，多副本安全）。
PARSE_CONCURRENCY=3
LISTEN_ADDR=:8000
# 允许跨域访问的来源列表，逗号分隔，精确匹配（`*` 表示放行所有来源）。
# WebTag 浏览器扩展从 `chrome-extension://<extension-id>` 源调用公开 API，
# 接入扩展时必须把该来源加进来，例如：
#   CORS_ORIGINS=http://localhost:3000,chrome-extension://abcdefghijklmnopabcdefghijklmnop
# 也可用 `*` 放行所有来源（自托管单用户场景可接受）。
CORS_ORIGINS=http://localhost:3000
# Comma-separated ingress/proxy CIDRs trusted to set X-Forwarded-For and
# X-Real-IP. Empty (default) ignores forwarding headers and uses RemoteAddr.
# Never use 0.0.0.0/0 or ::/0; startup rejects trust-all ranges.
TRUSTED_PROXY_CIDRS=

# 应用日志级别（debug / info / warn / error），默认 info。线上推荐
# info；排查问题时可临时调到 debug 看更多结构化字段。
LOG_LEVEL=info

# 日志输出格式（json / text），默认 json。生产保持 json，便于
# Loki / ELK / Splunk 等聚合系统按字段索引。本地开发推荐 text：
# 输出人类可读的 key=value 文本，并启用 AddSource 显示日志触发点
# 的 file:line，stack 一目了然。
LOG_FORMAT=json

# Optional HTTP server timeouts, in milliseconds
READ_HEADER_TIMEOUT_MS=2000
READ_TIMEOUT_MS=10000
WRITE_TIMEOUT_MS=15000
IDLE_TIMEOUT_MS=60000

# 优雅停机总预算（毫秒），默认 30000 = 30s。Server.Shutdown 使用同一个
# deadline 依次完成 HTTP 排空与 Runtime.Close；HTTP 排空耗时越久，后台 worker、
# feed scheduler、payload cleaner 和持久化资源关闭可用的剩余预算越少。连接池
# 开始关闭后会拒绝新的 acquire；若仍有连接被持有到 deadline 之后，进程返回
# timeout，由容器 / systemd 的终止宽限期负责最终兜底。
#
# 部署 k8s 时务必让 SHUTDOWN_TIMEOUT_MS 略低于 pod 的
# terminationGracePeriodSeconds（默认 30s），给容器自身的退出留 5~10%
# 余量；否则 kubelet 在 grace 到期后会发 SIGKILL，跳过剩余清理。下界 1000，
# 低于此值的预算无法可靠完成请求和 worker 排空。
SHUTDOWN_TIMEOUT_MS=30000

# Optional fetch retry controls
FETCH_RETRY_ATTEMPTS=2
FETCH_RETRY_DELAY_MS=25
# 解析模式：
#   grok_direct（默认）— 让已配置的 Grok 分析端点自抓 URL；模型无法访问时
#                        回退本地专用/基础抓取链。
#   fetcher            — 强制用本地抓取器获取正文，必要时回退 Jina，再交给模型分析。
#                        抓不到原文时明确失败，不会用搜索结果摘要冒充原文。
# 仅接受 fetcher / grok_direct；其它值会导致服务启动失败。
PARSE_MODE=grok_direct

# Optional analyzer retry and timeout controls
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_MS=25
AI_REQUEST_TIMEOUT_MS=60000

# 普通分析请求默认使用 strict json_schema（response_format）：
# 结构化输出让上游按 schema 约束解码，直接消灭"模型不按 JSON 契约回复"这类失败。
#
# 作用范围：**普通解析路径全部走它**——schema 按输出契约选，日常解析恒为网站收藏
# v2 的判别式联合体。不发该字段的只有两条：grok URL 直连（其 accessible 字段是
# 本地抓取器回退的依据）与 eval 的 prompt override（实验自持输出形状）。
#
# 一般不需要动这个开关：网关不支持时会返回 400/422，analyzer 自动摘掉该字段、
# 原样重发、本进程内不再发送，并 WARN 一次。首次结构化请求成功之前，任何 400/422
# 都触发降级（那时唯一变化的就是这个字段）；成功过之后只有错误明确点名
# response_format / json_schema 才降级，避免一次超长正文的 context_length_exceeded
# 永久关掉该能力。
#
# Optional GitHub fetcher token (raises rate limit on github.com URLs)
GITHUB_TOKEN=

# pgx connection pool sizing. DB_MIN_CONNS keeps idle connections warm for
# steady-state latency; DB_MAX_CONNS caps total database concurrency.
DB_MAX_CONNS=30
DB_MIN_CONNS=5

# pgxpool 连接生命周期。所有三项 <=0 时保留 pgx 默认（1h / 30min / 1min）。
# 生产部署在 PgBouncer / RDS Proxy 后面时强烈建议把 lifetime / idle 调得
# 比中间件的 server_idle_timeout 短，否则偶发会拿到一根已被对端 reset
# 的连接，表现为 "connection reset by peer" 长尾错误。
#
#   DB_MAX_CONN_LIFETIME_MS    单根连接最长存活时间（默认 30min）
#   DB_MAX_CONN_IDLE_TIME_MS   单根连接最长空闲时间（默认 10min）
#   DB_HEALTH_CHECK_PERIOD_MS  pgx 主动 ping 空闲连接的间隔（默认 1min）
DB_MAX_CONN_LIFETIME_MS=1800000
DB_MAX_CONN_IDLE_TIME_MS=600000
DB_HEALTH_CHECK_PERIOD_MS=60000

# 公开 API（/api/ingest、/api/links*、/api/tags、/api/tree）的静态 Bearer
# token，供 Reader、浏览器扩展和移动端使用。
# 必填；所有外部 API 始终要求该 token 或由它换取的浏览器会话。
EXTENSION_API_TOKEN=

# Reader 浏览器会话 cookie 的 HMAC-SHA256 签名密钥。
#
# 作用：Reader 用 EXTENSION_API_TOKEN 换一张有期限的 httpOnly cookie（POST /api/session），
# 之后凭 cookie 请求。页面脚本读不到 cookie，也就外带不走——Reader 会渲染来自
# 第三方网页的标题 / 摘要 / 正文，这条防线针对的正是那个面。
#
# 留空不等于关闭：进程启动时会随机生成一把，密钥随进程消亡。代价是每次重启
# ——包括每次自动更新——所有会话当场失效，而 Reader 在 session 模式下浏览器里
# 不留安装令牌，届时前端手里没有任何可重放的凭证，用户只能重新填一次 key。
# 留空时启动会打一条 WARN 说明这件事；scripts/cairn-install.sh 在新建
# /opt/webtag/.env 时会直接生成一把，所以这一项通常只在手写配置时需要关心。
# 显式配置的两个理由：
#   1. 让会话跨重启存活；
#   2. 需要跨进程复用签名密钥时必须配置。
# 生成：openssl rand -base64 32
#
# 换密钥 = 强制全体重新登录，这是撤回无状态会话的唯一手段。
SESSION_SIGNING_KEY=

# River 终态作业保留时间。设为 -1 会关闭清理，因此需要自行监控
# river_job 容量；其他值必须为正毫秒数。
RIVER_TERMINAL_RETENTION_MS=604800000

# 所有分页游标共用的 HMAC-SHA256 签名密钥。APP_ENV != dev 时必填，
# 且至少 32 字节；dev 留空时从本地 DATABASE_URL 与 AI_API_KEY 派生。
# 推荐生成：openssl rand -hex 32
# 切换密钥会让已下发的签名游标失效，客户端收到 422
# invalid_cursor；部署前需确认上游不会长期缓存旧 token。
CURSOR_SIGNING_KEY=

# Idempotency-Key 中间件（第二轮工程审计 API HIGH A1）。仅挂在公开 API
# 鉴权之后，并只对 POST/PUT/PATCH/DELETE 请求生效；客户端在请求头携带
# Idempotency-Key 时，中间件会按 (method, path, key) 缓存上一次
# 响应（仅 2xx / 4xx）。命中时直接回放 status + body + Content-Type，不再
# 调用 handler——既挡住"网络抖动 → 重试 → 重复 enqueue"，也不会绕过鉴权
# 无 Idempotency-Key 头的请求透传，不影响现有客户端。
#
# Phase 13（v4.0 M2）幂等下沉 PG：缓存改存 idempotency_keys 表
# （INSERT ON CONFLICT 抢占 + 回放），多副本部署下同一 Idempotency-Key 跨
# 副本生效（旧的进程内 LRU 在多副本下退化为 per-replica）。中间件仍不替代
# 后端 dedupe（DB source_key 唯一约束才是真正的资源防线），但现在挡客户端
# 重试 race 时跨副本一致。过期键由后台周期任务按 expires_at 清理。
#
# 缓存项过期时间，毫秒；0 → 中间件默认 24h。
IDEMPOTENCY_TTL_MS=0
